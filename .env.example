# Root environment template. Copy to .env and adjust.
# Individual services also have their own templates:
#   backend/.env.example   frontend/.env.local.example

# --- Database ---
# Local Postgres (docker-compose):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/energy_terminal
# Or zero-setup SQLite (no server needed):
# DATABASE_URL=sqlite:///./local.db

# --- Backend ---
APP_NAME=Energy Intelligence Terminal API
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# --- External data sources ---
ENERGI_DATA_SERVICE_BASE_URL=https://api.energidataservice.dk
OPEN_METEO_BASE_URL=https://api.open-meteo.com
ENTSOE_API_KEY=
DMI_API_KEY=

# --- AI Advisor (optional; the advisor works rule-based without a key) ---
OPENAI_API_KEY=
