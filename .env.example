# Root environment template. Copy to .env and adjust.
# Individual services also have their own templates:
#   backend/.env.example   frontend/.env.local.example

# --- Database ---
# Local Postgres (docker-compose):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/energy_terminal
# Or zero-setup SQLite (no server needed):
# DATABASE_URL=sqlite:///./local.db

# --- Backend ---
APP_NAME=Energy Intelligence Terminal API
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=http://localhost:3000
INIT_DB_ADMIN_TOKEN=change-me-for-local-admin-actions
# Leave empty for local demo mode. Set in production to require:
# Authorization: Bearer <APP_AUTH_TOKEN>
APP_AUTH_TOKEN=

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=/api/v1
BACKEND_API_ORIGIN=http://localhost:8000
# Server-only frontend proxy token. Match APP_AUTH_TOKEN when enabled.
BACKEND_API_TOKEN=

# --- External data sources ---
ENERGI_DATA_SERVICE_BASE_URL=https://api.energidataservice.dk
OPEN_METEO_BASE_URL=https://api.open-meteo.com
ENTSOE_API_KEY=
ERCOT_API_SUBSCRIPTION_KEY=
ERCOT_DAM_SPP_ENDPOINT=
JEPX_BASE_URL=
DMI_API_KEY=

# --- AI Advisor (optional; the advisor works rule-based without a key) ---
OPENAI_API_KEY=
